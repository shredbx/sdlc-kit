{%- set requirements = [] -%}
{%- for used in package.uses %}{% set _ = requirements.append(used) %}{% endfor -%}
{%- for requirement in package.dependencies %}{% set _ = requirements.append(requirement) %}{% endfor -%}
[project]
name = "{{ dist }}"
version = "{{ package.version }}"
description = "{{ package.description }}"
requires-python = ">=3.13"
dependencies = [{% for requirement in requirements %}"{{ requirement }}"{% if not loop.last %}, {% endif %}{% endfor %}]
{% if kind == "product" %}
[project.scripts]
{{ package.name }} = "{{ source }}:main"
{% endif %}
[dependency-groups]
dev = ["pytest>=8", "pyyaml>=6"]
{% if package.uses %}
[tool.uv.sources]
{% for used in package.uses -%}
{{ used }} = { workspace = true }
{% endfor %}{% endif %}
[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
only-include = ["src/{{ source }}"]
sources = ["src"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = ["--import-mode=importlib"]
